# ==============================================================================
# Supabase Edge Functions & Transactional Email Environment Configuration
# ==============================================================================

# Primary Transactional Email Provider: Resend (Recommended)
# Sign up at https://resend.com and generate an API key
RESEND_API_KEY=re_your_resend_api_key_here

# Verified Sender Address
# For development/testing with Resend sandbox: "Barangay Zapatera <onboarding@resend.dev>"
# For production with custom domain: "Barangay Zapatera <notifications@barangayzapatera.gov.ph>"
SENDER_EMAIL=Barangay Zapatera <onboarding@resend.dev>

# Optional Email Fallback Providers (if Resend is not used):
# BREVO_API_KEY=xkeysib-your-brevo-api-key
# SENDGRID_API_KEY=SG.your-sendgrid-api-key

# Official Barangay Office Metadata (Displayed in HTML Email Header & Footer)
BARANGAY_NAME=BARANGAY ZAPATERA
BARANGAY_ADDRESS=Barangay Hall, Rahmann St., Zapatera, Cebu City, Philippines 6000
BARANGAY_HOTLINE=(032) 254-8721 / zapatera.cebucity@gmail.com
BARANGAY_HOURS=Monday to Friday: 8:00 AM – 5:00 PM

# Supabase Project Credentials (Automatically injected by Supabase runtime)
# Only required if testing functions locally with `supabase functions serve`
SUPABASE_URL=https://qzmxwxmtuzoanwevftnd.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here
